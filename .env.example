# Telegram
BOT_TOKEN=replace-with-bot-token
TARGET_CHAT_ID=-1001234567890
ADMIN_CHAT_ID=123456789

# Remnawave
REMNAWAVE_BASE_URL=https://panel.diler.tech
REMNAWAVE_TOKEN=replace-with-remnawave-api-token
REMNAWAVE_SUB_BASE_URL=https://sub.diler.tech

# Database. Use PostgreSQL in production, for example:
# DATABASE_URL=postgresql+asyncpg://rembot:password@127.0.0.1:5432/rembot
DATABASE_URL=sqlite+aiosqlite:///./rembot.sqlite3

# Access sync
MEMBERSHIP_CHECK_INTERVAL_SECONDS=1800

# Optional HTTP settings
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
