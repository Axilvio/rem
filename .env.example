# Global
ENV=production
TZ=UTC
LOG_LEVEL=INFO

# Panel stack
PANEL_DOMAIN=panel.example.com
PANEL_API_BASE_URL=https://panel.example.com
PANEL_API_TOKEN=change-me
PANEL_POSTGRES_DB=remnawave
PANEL_POSTGRES_USER=remnawave
PANEL_POSTGRES_PASSWORD=change-me
PANEL_REDIS_PASSWORD=change-me
CADDY_EMAIL=admin@example.com
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Node stack
NODE_SECRET_KEY=change-me
NODE_PUBLIC_DOMAIN=node-eu.example.com
NODE_BRIDGE_UPSTREAM_HOST=de-exit.example.net
NODE_BRIDGE_UPSTREAM_PORT=9999

# Bot
BOT_TOKEN=change-me
BOT_WEBHOOK_SECRET=change-me
BOT_BASE_URL=https://bot.example.com
BOT_ADMIN_IDS=11111111,22222222
BOT_DB_DSN=postgresql+asyncpg://bot:change-me@bot-db:5432/bot
BOT_REDIS_URL=redis://:change-me@bot-redis:6379/0
TRIAL_DAYS=2
DEFAULT_DEVICE_LIMIT=3
DEFAULT_TRAFFIC_LIMIT_GB=300
REFERRAL_BONUS_DAYS=7
SUBSCRIPTION_BASE_URL=https://sub.example.com

# Payments
PAYMENT_PROVIDER=cryptomus
CRYPTOMUS_API_KEY=change-me
CRYPTOMUS_MERCHANT_ID=change-me
CRYPTOMUS_WEBHOOK_SECRET=change-me
CRYPTOCLOUD_API_KEY=change-me
OXAPAY_API_KEY=change-me

# Admin web
ADMIN_SECRET_KEY=change-me-long-random
ADMIN_SESSION_TTL_MINUTES=240
ADMIN_DB_DSN=postgresql+asyncpg://admin:change-me@admin-db:5432/admin
ADMIN_API_TOKEN=change-me-admin-token
ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# Monitoring
PROMETHEUS_BASIC_AUTH_USER=prom
PROMETHEUS_BASIC_AUTH_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
ALERT_BOT_TOKEN=change-me
ALERT_CHAT_ID=123456
